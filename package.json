{
  "name": "sales-copilot",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "postinstall": "node scripts/write_build_info.js",
    "build:info": "node scripts/write_build_info.js",
    "typecheck": "tsc --noEmit",
    "backend": "tsx backend/server.ts",
    "simulator": "node simulator/serve.js",
    "web:dev": "vite --config web/vite.config.mts",
    "web:build": "node scripts/write_build_info.js && vite build --config web/vite.config.mts",
    "web:preview": "vite preview --config web/vite.config.mts",
    "landing:legal": "tsx scripts/build_landing_legal.ts",
    "bundle:android": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res"
  },
  "dependencies": {
    "@react-native-clipboard/clipboard": "^1.14.1",
    "@supabase/supabase-js": "2.49.4",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-document-picker": "9.3.1",
    "react-native-image-picker": "7.1.2",
    "react-native-mmkv": "^2.12.2",
    "react-native-svg": "15.8.0",
    "react-native-url-polyfill": "2.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@react-native/babel-preset": "0.74.87",
    "@react-native/metro-config": "0.74.87",
    "@react-native/typescript-config": "0.74.87",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.2.6",
    "@vitejs/plugin-react": "4.3.4",
    "express": "^4.19.2",
    "react-dom": "18.2.0",
    "react-native-web": "0.19.13",
    "tsx": "^4.16.0",
    "typescript": "5.0.4",
    "vite": "5.4.11"
  }
}
