{
  "name": "sales-copilot",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "postinstall": "node scripts/write_build_info.js",
    "build:info": "node scripts/write_build_info.js",
    "typecheck": "tsc --noEmit",
    "backend": "tsx backend/server.ts",
    "simulator": "node simulator/serve.js",
    "web:dev": "vite --config web/vite.config.mts",
    "web:build": "node scripts/write_build_info.js && vite build --config web/vite.config.mts",
    "web:preview": "vite preview --config web/vite.config.mts",
    "locker:dev": "vite --config locker/vite.config.mts",
    "locker:build": "vite build --config locker/vite.config.mts",
    "locker:typecheck": "tsc -p locker/tsconfig.json",
    "landing:legal": "tsx scripts/build_landing_legal.ts",
    "landing:site": "node scripts/build_landing_site.mjs",
    "bundle:android": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res"
  },
  "dependencies": {
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@supabase/supabase-js": "2.49.4",
    "expo": "~54.0.38",
    "expo-glass-effect": "~0.1.10",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-document-picker": "9.3.1",
    "react-native-image-picker": "7.1.2",
    "react-native-mmkv": "^2.12.2",
    "react-native-purchases": "10.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "2.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@react-native-community/cli": "20.0.2",
    "@react-native-community/cli-platform-android": "20.0.2",
    "@react-native-community/cli-platform-ios": "20.0.2",
    "@react-native/babel-preset": "0.81.5",
    "@react-native/metro-config": "0.81.5",
    "@react-native/typescript-config": "0.81.5",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.1.17",
    "@types/react-dom": "~19.1.11",
    "@vitejs/plugin-react": "4.3.4",
    "babel-preset-expo": "~54.0.12",
    "express": "^4.19.2",
    "react-dom": "19.1.0",
    "react-native-web": "~0.21.0",
    "tsx": "^4.16.0",
    "typescript": "~5.9.2",
    "vite": "5.4.11"
  }
}
