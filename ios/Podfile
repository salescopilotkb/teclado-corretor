# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# 15.5: mínimo do Google ML Kit (tradução do teclado)
platform :ios, '15.5'
prepare_react_native_project!

# Projeto gerado pelo XcodeGen (ios/project.yml)
project 'CorretorKeyboard.xcodeproj'

target 'CorretorKeyboard' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => true,
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # Alvo da extensão de teclado personalizada compartilhando pods do React
  target 'CorretorKeyboardExtension' do
    inherit! :complete
    # Tradução no aparelho (botão Traduzir), igual ao Android — só o teclado usa
    pod 'GoogleMLKit/Translate', '~> 7.0'
  end

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )
    # Os pods também entram no teclado: o CocoaPods então liga
    # APPLICATION_EXTENSION_API_ONLY e as bibliotecas que usam
    # UIApplication.sharedApplication (galeria, documentos) deixam de compilar.
    # Essas partes só rodam no app; no teclado o JS não as chama.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_config|
        build_config.build_settings['APPLICATION_EXTENSION_API_ONLY'] = 'NO'
        # O ML Kit não tem versão para o simulador arm64 (Mac com Apple Silicon)
        build_config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'arm64'
        if build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < 15.5
          build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.5'
        end
        # Xcode 16.3+: a fmt do RN 0.74 não compila em C++20 (erro de consteval); em C++17 compila
        if target.name == 'fmt'
          build_config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
        end
      end
    end
  end
end
