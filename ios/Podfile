# React Native 0.81 + Expo SDK 54. O teclado usa a arquitetura antiga
# (RCTBridge/RCTRootView na extensão), a mesma do Android (newArchEnabled=false).
ENV['RCT_NEW_ARCH_ENABLED'] = '0'

# Autolinking do Expo (módulos do Expo, ex.: expo-glass-effect) e do React Native
require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), "scripts/autolinking")
require File.join(File.dirname(`node --print "require.resolve('react-native/package.json')"`), "scripts/react_native_pods")

# 15.5: mínimo do Google ML Kit (tradução do teclado)
platform :ios, '15.5'
prepare_react_native_project!

# Projeto gerado pelo XcodeGen (ios/project.yml)
project 'CorretorKeyboard.xcodeproj'

target 'CorretorKeyboard' do
  use_expo_modules!

  config_command = [
    'node',
    '--no-warnings',
    '--eval',
    'require(\'expo/bin/autolinking\')',
    'expo-modules-autolinking',
    'react-native-config',
    '--json',
    '--platform',
    'ios'
  ]
  config = use_native_modules!(config_command)

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => true,
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # Alvo da extensão de teclado personalizada compartilhando pods do React
  target 'CorretorKeyboardExtension' do
    inherit! :complete
    # Tradução no aparelho (botão Traduzir), igual ao Android — só o teclado usa
    pod 'GoogleMLKit/Translate', '~> 7.0'
  end

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )
    # Os pods também entram no teclado: o CocoaPods então liga
    # APPLICATION_EXTENSION_API_ONLY e as bibliotecas que usam
    # UIApplication.sharedApplication (galeria, documentos) deixam de compilar.
    # Essas partes só rodam no app; no teclado o JS não as chama.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_config|
        build_config.build_settings['APPLICATION_EXTENSION_API_ONLY'] = 'NO'
        # O ML Kit não tem versão para o simulador arm64 (Mac com Apple Silicon)
        build_config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'arm64'
        if build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < 15.5
          build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.5'
        end
        # Xcode 16.3+: versões antigas da fmt não compilam em C++20 (consteval); em C++17 compilam
        if target.name == 'fmt'
          build_config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
        end
      end
    end
  end
end
