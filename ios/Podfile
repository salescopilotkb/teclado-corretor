# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, '14.0'
prepare_react_native_project!

# Projeto gerado pelo XcodeGen (ios/project.yml)
project 'CorretorKeyboard.xcodeproj'

target 'CorretorKeyboard' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => true,
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # Alvo da extensão de teclado personalizada compartilhando pods do React
  target 'CorretorKeyboardExtension' do
    inherit! :complete
  end

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )
    # Os pods também entram no teclado: o CocoaPods então liga
    # APPLICATION_EXTENSION_API_ONLY e as bibliotecas que usam
    # UIApplication.sharedApplication (galeria, documentos) deixam de compilar.
    # Essas partes só rodam no app; no teclado o JS não as chama.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_config|
        build_config.build_settings['APPLICATION_EXTENSION_API_ONLY'] = 'NO'
      end
    end
  end
end
