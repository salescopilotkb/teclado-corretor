# Locker web (locker.keyconapp.com) no HostGator
# - HTTPS sempre
# - /f/<código>, /d/<código> e qualquer outro caminho abrem o mesmo index.html (o
#   Locker decide o que mostrar); arquivos que existem (assets, ícones) vão direto
# - cache: os assets têm nome com hash (guardar por 1 ano); a página, o service
#   worker e o manifesto sempre conferem a versão nova
Options -Indexes
ServerSignature Off
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Arquivos ocultos (.env, .git...) e cópias esquecidas: proibido (.well-known fica aberto)
  RewriteRule (^|/)\.(?!well-known(/|$)) - [F,L]
  RewriteRule \.(bak|old|orig|swp|sql|log|ini|env)$ - [F,L,NC]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]
</IfModule>

AddType application/manifest+json .webmanifest
AddType text/javascript .js

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  # Navegador só usa HTTPS por 1 ano; o resto do navegador fica fechado ao que o Locker não usa
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header unset X-Powered-By
  <FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
